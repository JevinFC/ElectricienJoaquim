---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import CtaBanner from '../components/CtaBanner.astro';
import Gallery, { type GalleryImage, type GalleryItem } from '../components/Gallery.tsx';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRealisations, getServices, titreService } from '../lib/collections.ts';
import { formatDateIso, formatMoisAnnee } from '../lib/format.ts';

const [services, realisations] = await Promise.all([getServices(), getRealisations()]);
const { zone } = site;

/**
 * Optimise une image côté Astro (getImage) et renvoie des données sérialisables pour
 * l'île React. Aucun format n'est imposé : les photos JPG/PNG sont converties en WebP,
 * les visuels SVG provisoires restent en SVG. Les largeurs dépassant l'original sont ignorées.
 */
async function optimiser(src: ImageMetadata, alt: string, largeurs: number[], ratio?: number): Promise<GalleryImage> {
  const largeur = Math.min(largeurs[largeurs.length - 1] ?? src.width, src.width);
  const image = await getImage({
    src,
    width: largeur,
    ...(ratio ? { height: Math.round(largeur / ratio), fit: 'cover' as const } : {}),
    widths: largeurs,
    layout: 'none',
  });

  return {
    src: image.src,
    srcset: image.srcSet.attribute,
    width: Number(image.attributes.width),
    height: Number(image.attributes.height),
    alt,
  };
}

const items: GalleryItem[] = await Promise.all(
  realisations.map(async (realisation) => {
    const { titre, ville, date, service, couverture, photos, exemple } = realisation.data;
    return {
      id: realisation.id,
      titre,
      ville,
      date: formatDateIso(date),
      dateLabel: formatMoisAnnee(date),
      serviceId: service.id,
      serviceTitre: titreService(services, service.id),
      exemple,
      // Vignette recadrée en 4:3 pour la grille.
      couverture: await optimiser(couverture.src, couverture.alt, [400, 640, 960], 4 / 3),
      // Photos en grand pour la visionneuse, couverture comprise.
      photos: await Promise.all(
        [couverture, ...photos].map((photo) => optimiser(photo.src, photo.alt, [800, 1200, 1600])),
      ),
    };
  }),
);

const servicesGalerie = services.map((service) => ({ id: service.id, titre: service.data.titre }));
const contientExemples = items.some((item) => item.exemple);
---

<BaseLayout
  title={`Réalisations ${zone.libelle}`}
  description="Chantiers d'installation électrique neuve, de rénovation et de mise aux normes de tableaux électriques réalisés à Tours et en Indre-et-Loire."
>
  <PageHeader
    fil={[{ href: '/', label: 'Accueil' }]}
    filCourant="Réalisations"
    eyebrow="Réalisations"
    titre={`Réalisations ${zone.libelle}`}
    intro="Installation neuve, rénovation, tableaux électriques : une sélection de chantiers. Filtrez par type de travaux et ouvrez les photos."
  />

  <section class="py-14 sm:py-20" aria-label="Galerie des réalisations">
    <div class="container-page">
      {
        contientExemples && (
          <p class="mb-8 rounded-lg border border-line bg-paper-deep p-4 text-sm">
            Les chantiers marqués «&nbsp;Exemple&nbsp;» sont fictifs : ils sont affichés en attendant les photos des
            chantiers réels.
          </p>
        )
      }
      {
        items.length > 0 ? (
          <Gallery client:visible items={items} services={servicesGalerie} />
        ) : (
          <p class="text-lg text-muted">Les premières réalisations seront bientôt publiées.</p>
        )
      }
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
