---
import CtaBanner from '../components/CtaBanner.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../config/photos.ts';
import { site } from '../config/site.ts';
import { etapesIntervention } from '../lib/intervention.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const { entreprise, contact, parcours, delaiRappel, assuranceDecennale, certifications, zone } = site;

---

<BaseLayout
  title={`${entreprise.gerantNomUsuel}, électricien ${zone.libelle}`}
  description={`Présentation de ${entreprise.gerantNomUsuel}, électricien à son compte ${zone.libelle} : parcours, méthode de travail et garanties.`}
>
  <PageHeader
    fil={[{ href: '/', label: 'Accueil' }]}
    filCourant="À propos"
    titre={`${entreprise.gerantNomUsuel}, électricien ${zone.libelle}`}
  />

  <section class="py-14 sm:py-20" aria-labelledby="parcours-titre">
    <div class="container-page grid gap-12 md:grid-cols-[2fr_3fr] lg:gap-16">
      <Photo
        {...photos.portrait}
        width={600}
        height={750}
        sizes="(min-width: 768px) 40vw, 100vw"
        priority
        class="aspect-4/5 w-full max-w-md rounded-conteneur"
      />
      <div class="prose-content">
        <h2 id="parcours-titre">Mon parcours</h2>
        <p>
          J'ai commencé l'électricité très jeune et je n'ai jamais fait d'autre métier&nbsp;: cela fait
          {parcours.anneesMetier}&nbsp;ans que je travaille sur les chantiers. Depuis {parcours.anneeInstallation}, je suis
          installé à mon compte à {contact.adresse.ville}.
        </p>
        {/* TODO : parcours à compléter avec le client, sans rien inventer. */}
        <p>[Où Joaquim a appris le métier&nbsp;: formation, premières entreprises, types de chantiers.]</p>
        {/* TODO : ce qui motive le gérant dans son métier, à la première personne. */}
        <p>[Ce qui le motive dans son métier, en deux ou trois phrases à la première personne.]</p>
        <h2>Un artisan local</h2>
        <p>
          J'interviens {zone.libelle} chez les particuliers&nbsp;: installation électrique neuve, rénovation et mise aux
          normes de tableaux électriques. Je travaille seul&nbsp;: c'est à moi que vous parlez, du premier appel à la fin
          du chantier, et je vous rappelle toujours sous {delaiRappel}.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-bordure py-16 sm:py-20" aria-labelledby="methode-titre">
    <div class="container-page">
      <h2 id="methode-titre" class="text-3xl leading-tight font-bold sm:text-4xl">Comment se déroule un chantier</h2>
      <div class="prose-content mt-8">
        <ol>
          {
            etapesIntervention.map(({ titre, texte }) => (
              <li>
                <strong>{titre}.</strong> {texte}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="border-t border-bordure py-16 sm:py-20" aria-labelledby="garanties-titre">
    <div class="container-page">
      <h2 id="garanties-titre" class="text-3xl leading-tight font-bold sm:text-4xl">Assurance et qualifications</h2>
      <dl class="mt-8 max-w-3xl divide-y divide-bordure border-y border-bordure">
        <div class="py-6">
          <dt class="font-titre text-lg font-bold">Assurance responsabilité civile décennale</dt>
          <dd class="mt-2 text-gris-ardoise">
            Assureur&nbsp;: {assuranceDecennale.assureur}<br />
            Zone couverte&nbsp;: {assuranceDecennale.zoneCouverte}
          </dd>
        </div>
        <div class="py-6">
          <dt class="font-titre text-lg font-bold">Norme NF C 15-100</dt>
          <dd class="mt-2 text-gris-ardoise">
            Les installations sont réalisées conformément à la norme qui encadre la sécurité des installations électriques
            des logements.
          </dd>
        </div>
        {
          certifications.map(({ nom, organisme, url }) => (
            <div class="py-6">
              <dt class="font-titre text-lg font-bold">{nom}</dt>
              <dd class="mt-2 text-gris-ardoise">
                {organisme && <span>Délivrée par {organisme}. </span>}
                {url && (
                  <a href={url} class="font-semibold text-cuivre underline" rel="noopener">
                    Vérifier cette qualification
                  </a>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
