---
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const { telephone } = site.contact;
---

<BaseLayout title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <PageHeader
    etiquette="404 · Circuit coupé"
    titre="Page introuvable"
    intro="La page demandée n'existe pas ou a été déplacée. Retournez à l'accueil, ou appelez-moi directement pour votre projet."
  >
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-outline-light">Retour à l'accueil</a>
      <a href={`tel:${telephone.lien}`} class="btn btn-primary">
        <Icon name="telephone" class="size-5" />
        <span>Appeler</span>
        <span class="font-normal">{telephone.affichage}</span>
      </a>
    </div>
  </PageHeader>
</BaseLayout>
