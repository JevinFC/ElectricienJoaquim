---
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const { entreprise, contact, hebergeur, assuranceDecennale, mediateur } = site;
const adresse = `${contact.adresse.rue}, ${contact.adresse.codePostal} ${contact.adresse.ville}`;
const estUrl = (valeur: string) => valeur.startsWith('http');
---

<BaseLayout
  title="Mentions légales"
  description={`Mentions légales du site ${entreprise.nom} : éditeur, hébergeur, assurance professionnelle et médiation de la consommation.`}
>
  <PageHeader fil={[{ href: '/', label: 'Accueil' }]} titre="Mentions légales" />

  <div class="container-page py-14 sm:py-20">
    <div class="prose-content">
      <p>
        Conformément à la loi n° 2004-575 du 21 juin 2004 pour la confiance dans l'économie numérique (LCEN), les
        informations relatives à l'éditeur et à l'hébergeur de ce site sont précisées ci-dessous.
      </p>

      <h2>Éditeur du site</h2>
      <ul>
        <li><strong>Entreprise&nbsp;:</strong> {entreprise.nom}</li>
        <li><strong>Forme juridique&nbsp;:</strong> {entreprise.formeJuridique}</li>
        {entreprise.capitalSocial && <li><strong>Capital social&nbsp;:</strong> {entreprise.capitalSocial}</li>}
        <li><strong>Dirigeant&nbsp;:</strong> {entreprise.gerant}</li>
        <li><strong>Adresse&nbsp;:</strong> {adresse}</li>
        <li>
          <strong>Téléphone&nbsp;:</strong> <a href={`tel:${contact.telephone.lien}`}>{contact.telephone.affichage}</a>
        </li>
        <li><strong>E-mail&nbsp;:</strong> <a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><strong>SIRET&nbsp;:</strong> {entreprise.siret}</li>
        <li><strong>Immatriculation&nbsp;:</strong> {entreprise.immatriculation}</li>
        <li><strong>TVA&nbsp;:</strong> {entreprise.tva}</li>
      </ul>

      <h2>Directeur de la publication</h2>
      <p>{entreprise.gerant}, en qualité de dirigeant de l'entreprise.</p>

      <h2>Hébergement</h2>
      <p>
        Le site est hébergé par {hebergeur.nom}, {hebergeur.adresse}. Téléphone&nbsp;: {hebergeur.telephone}. Site
        internet&nbsp;: <a href={hebergeur.site}>{hebergeur.site}</a>.
      </p>

      <h2>Assurance professionnelle</h2>
      <p>
        L'entreprise est assurée en responsabilité civile décennale auprès de {assuranceDecennale.assureur} ({assuranceDecennale.coordonnees}),
        contrat n° {assuranceDecennale.numeroContrat}. Couverture géographique&nbsp;: {assuranceDecennale.zoneCouverte}.
      </p>

      <h2>Médiation de la consommation</h2>
      <p>
        Conformément aux articles L612-1 et suivants du Code de la consommation, le client consommateur peut recourir
        gratuitement à un médiateur de la consommation en cas de litige, après avoir adressé une réclamation écrite à
        l'entreprise. Médiateur compétent&nbsp;: {mediateur.nom}, {mediateur.adresse},
        {estUrl(mediateur.site) ? <a href={mediateur.site}>{mediateur.site}</a> : mediateur.site}.
      </p>

      <h2>Propriété intellectuelle</h2>
      <p>
        Les contenus de ce site (textes, photographies, logotype, mise en page) sont la propriété de {entreprise.nom},
        sauf mention contraire. Toute reproduction, même partielle, est interdite sans autorisation écrite préalable.
      </p>
      <p>
        Polices de caractères&nbsp;: Bitter, Public Sans et IBM Plex Mono, distribuées sous licence SIL Open Font License
        1.1 et hébergées sur ce site.
      </p>
      {/* TODO : auteur des photos, une fois les vraies photos en place. */}
      <p>Crédits photos&nbsp;: [auteur des photos].</p>

      <h2>Données personnelles</h2>
      <p>
        Le traitement des informations transmises via le formulaire de contact est détaillé dans la
        <a href="/confidentialite/">politique de confidentialité</a>.
      </p>
    </div>
  </div>
</BaseLayout>
