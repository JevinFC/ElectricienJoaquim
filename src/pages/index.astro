---
import { Image } from 'astro:assets';
import portrait from '../assets/placeholders/gerant.svg';
import CtaBanner from '../components/CtaBanner.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import RealisationCard from '../components/RealisationCard.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustSection from '../components/TrustSection.astro';
import ZoneSection from '../components/ZoneSection.astro';
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRealisations, getServices, titreService } from '../lib/collections.ts';

const services = await getServices();
const dernieresRealisations = (await getRealisations()).slice(0, 3);
const { entreprise, zone } = site;
---

<BaseLayout
  title={`Électricien ${zone.libelle}`}
  description="Électricien à Tours et en Indre-et-Loire : installation électrique neuve, rénovation et mise aux normes de tableaux électriques. Devis gratuit."
>
  <Hero />

  <section class="py-16 sm:py-24" aria-labelledby="services-titre">
    <div class="container-page">
      <p class="eyebrow">Services</p>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <h2 id="services-titre" class="max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">
          Installation, rénovation et mise aux normes
        </h2>
        <a href="/services/" class="inline-flex items-center gap-2 font-bold underline-offset-4 hover:underline">
          Tous les services
          <Icon name="fleche" class="size-5" />
        </a>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          services.map((service) => (
            <li>
              <ServiceCard service={service} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <TrustSection />

  {
    dernieresRealisations.length > 0 && (
      <section class="py-16 sm:py-24" aria-labelledby="realisations-titre">
        <div class="container-page">
          <p class="eyebrow">Réalisations</p>
          <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
            <h2 id="realisations-titre" class="text-3xl leading-tight font-bold sm:text-4xl">
              Derniers chantiers
            </h2>
            <a href="/realisations/" class="inline-flex items-center gap-2 font-bold underline-offset-4 hover:underline">
              Toutes les réalisations
              <Icon name="fleche" class="size-5" />
            </a>
          </div>
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {dernieresRealisations.map((realisation) => (
              <li>
                <RealisationCard realisation={realisation} service={titreService(services, realisation.data.service.id)} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="border-t border-line bg-paper-deep" aria-labelledby="presentation-titre">
    <div class="container-page grid items-center gap-10 py-16 sm:py-24 md:grid-cols-[2fr_3fr] lg:gap-16">
      <Image
        src={portrait}
        alt={`Portrait de ${entreprise.gerant}`}
        width={480}
        height={600}
        sizes="(min-width: 768px) 40vw, 100vw"
        class="aspect-4/5 w-full max-w-sm rounded-xl object-cover"
      />
      <div>
        <p class="eyebrow">À propos</p>
        <h2 id="presentation-titre" class="mt-3 text-3xl leading-tight font-bold sm:text-4xl">Qui suis-je&nbsp;?</h2>
        <p class="mt-4 text-lg">
          Je suis {entreprise.gerant}, électricien à mon compte. J'interviens {zone.libelle} chez les particuliers, de
          l'installation neuve à la mise aux normes.
        </p>
        <p class="mt-4 text-muted">
          TODO : deux ou trois phrases de présentation à rédiger avec le client (parcours, façon de travailler).
        </p>
        <a href="/a-propos/" class="btn btn-secondary mt-8">En savoir plus</a>
      </div>
    </div>
  </section>

  <ReviewsSection />
  <ZoneSection />
  <CtaBanner />
</BaseLayout>
