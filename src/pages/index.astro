---
import CtaBanner from '../components/CtaBanner.astro';
import Hero from '../components/Hero.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import TrustSection from '../components/TrustSection.astro';
import ZoneSection from '../components/ZoneSection.astro';
import { site } from '../config/site.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={`Électricien ${site.zone.libelle}`}
  description="Électricien à Tours et en Indre-et-Loire : installation électrique neuve, rénovation et mise aux normes de tableaux électriques. Devis gratuit."
>
  <Hero />
  <TrustSection />
  <ReviewsSection />
  <ZoneSection />
  <CtaBanner />
</BaseLayout>
