---
import CircuitPattern from './CircuitPattern.astro';
import Icon from './Icon.astro';
import { site } from '../config/site.ts';

const { telephone } = site.contact;
const { zone } = site;
const reassurance = ['Devis gratuit', 'Assurance décennale', 'Norme NF C 15-100'];
---

<section class="relative isolate overflow-hidden border-b border-line">
  <CircuitPattern variant="hero" class="absolute inset-0 -z-10 size-full text-ink" />
  <div class="container-page py-16 sm:py-24 lg:py-28">
    <p class="eyebrow">Artisan électricien · {zone.departement} ({zone.numeroDepartement})</p>
    <h1 class="mt-5 max-w-3xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl lg:text-6xl">
      Électricien {zone.libelle}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">
      Installation électrique neuve, rénovation et mise aux normes de tableaux électriques. Un seul interlocuteur, du
      devis à la mise en service.
    </p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href={`tel:${telephone.lien}`} class="btn btn-primary">
        <Icon name="telephone" class="size-5" />
        <span>Appeler</span>
        <span class="font-normal">{telephone.affichage}</span>
      </a>
      <a href="/contact/" class="btn btn-secondary">Demander un devis</a>
    </div>
    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold">
      {
        reassurance.map((point) => (
          <li class="flex items-center gap-2">
            <Icon name="coche" class="size-5" />
            {point}
          </li>
        ))
      }
    </ul>
  </div>
</section>
