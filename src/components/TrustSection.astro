---
import CircuitPattern from './CircuitPattern.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons.ts';
import { site } from '../config/site.ts';

const { assuranceDecennale, certifications } = site;

const engagements: { icone: IconName; titre: string; texte: string }[] = [
  {
    icone: 'devis',
    titre: 'Devis gratuit',
    texte: "Chaque projet fait l'objet d'un devis détaillé, gratuit et sans engagement.",
  },
  {
    icone: 'assurance',
    titre: 'Assurance décennale',
    texte: `Mes travaux sont couverts par une assurance responsabilité civile décennale souscrite auprès de ${assuranceDecennale.assureur}.`,
  },
  {
    icone: 'norme',
    titre: 'Travail aux normes',
    texte:
      'Les installations sont réalisées conformément à la norme NF C 15-100, qui encadre la sécurité des installations électriques.',
  },
];
---

<section class="surface-dark relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="confiance-titre">
  <CircuitPattern class="absolute inset-0 -z-10 size-full text-paper" />
  <div class="container-page py-16 sm:py-24">
    <p class="eyebrow">Mes engagements</p>
    <h2 id="confiance-titre" class="mt-3 max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">
      Un travail sérieux, en toute transparence
    </h2>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        engagements.map(({ icone, titre, texte }) => (
          <li class="rounded-xl border border-white/10 bg-ink-soft p-6 sm:p-8">
            <Icon name={icone} class="size-9 text-accent" />
            <h3 class="mt-5 text-xl font-bold">{titre}</h3>
            <p class="mt-2 text-mist">{texte}</p>
          </li>
        ))
      }
    </ul>

    {
      certifications.length > 0 && (
        <div class="mt-12">
          <h3 class="text-xl font-bold">Qualifications</h3>
          <ul class="mt-4 flex flex-wrap gap-3">
            {certifications.map(({ nom, organisme, url }) => (
              <li class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-4 py-2">
                <Icon name="certification" class="size-5 text-accent" />
                {url ? (
                  <a href={url} class="font-bold underline underline-offset-4" rel="noopener">
                    {nom}
                  </a>
                ) : (
                  <span class="font-bold">{nom}</span>
                )}
                {organisme && <span class="text-mist">({organisme})</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
