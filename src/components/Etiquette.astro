---
interface Props {
  /** Libellé en casse normale, précédé d'un petit losange cuivre. */
  texte: string;
  /** Posée sur une photo : fond tuffeau-clair pour rester lisible. */
  surPhoto?: boolean;
  class?: string;
}

const { texte, surPhoto = false, class: className } = Astro.props;
---

<!-- Libellé discret : petit losange cuivre suivi d'un texte en Public Sans (styles dans global.css). -->
<span class:list={['etiquette', surPhoto && 'etiquette-photo', className]}>
  <span class="losange" aria-hidden="true"></span>
  <span>{texte}</span>
</span>
