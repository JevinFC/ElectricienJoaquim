---
import { site } from '../config/site.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!--
  Logotype texte en Bitter, utilisé sur fond ardoise (en-tête, pied de page) :
  nom en tuffeau, « Électricité » en cuivre-clair. Deux lignes sur mobile, une à partir de sm.
-->
<span
  class:list={[
    'inline-flex flex-col gap-0.5 font-titre text-lg leading-none font-bold sm:flex-row sm:gap-x-[0.3em]',
    className,
  ]}
>
  <span>{site.entreprise.nom}</span>
  <span class="text-cuivre-clair">Électricité</span>
</span>
