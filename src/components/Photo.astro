---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  /** Photo optimisée par Astro. Sans elle, un emplacement réservé affiche le texte `alt`. */
  src?: ImageMetadata | undefined;
  /** Description de la photo : texte alternatif, ou consigne affichée dans l'emplacement réservé. */
  alt: string;
  /** Dimensions maximales de rendu : la photo est recadrée à ces proportions. */
  width: number;
  height: number;
  sizes: string;
  /** Photo principale de la page (hero, en-tête) : chargée en priorité. */
  priority?: boolean;
  /** Classes communes à la photo et à l'emplacement réservé : proportions, arrondi… */
  class?: string;
}

const { src, alt, width, height, sizes, priority = false, class: className } = Astro.props;
---

{
  src ? (
    <Image
      src={src}
      alt={alt}
      width={width}
      height={height}
      sizes={sizes}
      priority={priority}
      class:list={['object-cover', className]}
    />
  ) : (
    <div class:list={['photo-a-venir', className]}>
      <span class="font-semibold tracking-wide uppercase">Photo à venir</span>
      <span class="max-w-[32ch] text-balance">{alt}</span>
    </div>
  )
}
