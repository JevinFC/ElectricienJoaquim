---
import CircuitPattern from './CircuitPattern.astro';
import Icon from './Icon.astro';
import { site } from '../config/site.ts';

interface Props {
  titre?: string;
  texte?: string;
}

//   : espace insécable avant « ? » et « : » (typographie française).
const {
  titre = 'Un projet électrique ? Parlons-en.',
  texte = 'Décrivez-moi votre besoin : je vous réponds avec un devis détaillé et gratuit.',
} = Astro.props;
const { telephone } = site.contact;
---

<section class="py-12 sm:py-16" aria-labelledby="cta-titre">
  <div class="container-page">
    <div class="surface-dark relative isolate overflow-hidden rounded-2xl bg-ink px-6 py-12 text-paper sm:px-12 sm:py-16">
      <CircuitPattern class="absolute inset-0 -z-10 size-full text-paper" />
      <h2 id="cta-titre" class="max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">{titre}</h2>
      <p class="mt-4 max-w-xl text-lg text-mist">{texte}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${telephone.lien}`} class="btn btn-primary">
          <Icon name="telephone" class="size-5" />
          <span>Appeler</span>
          <span class="font-normal">{telephone.affichage}</span>
        </a>
        <a href="/contact/" class="btn btn-outline-light">Demander un devis</a>
      </div>
    </div>
  </div>
</section>
