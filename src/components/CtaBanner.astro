---
import Icon from './Icon.astro';
import { promesse, site } from '../config/site.ts';

interface Props {
  titre?: string;
  texte?: string;
}

const { contact } = site;
const {
  titre = 'Décrivez-moi votre projet',
  texte = `${promesse('rappel').phrase} ${promesse('devis').phrase}`,
} = Astro.props;
const { telephone } = contact;
---

<!-- Bandeau final ardoise, qui forme un bloc avec le pied de page ; filet cuivre de 3 px en haut. -->
<section class="surface-dark border-t-[3px] border-cuivre bg-ardoise text-tuffeau" aria-labelledby="cta-titre">
  <div class="container-page py-14 sm:py-20">
    <h2 id="cta-titre" class="max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">{titre}</h2>
    <p class="mt-4 max-w-xl text-lg text-sable">{texte}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={`tel:${telephone.lien}`} class="btn btn-primary">
        <Icon name="telephone" class="size-5" />
        <span>Appeler</span>
        <span class="font-normal">{telephone.affichage}</span>
      </a>
      <a href="/contact/" class="btn btn-outline-light">Demander un devis</a>
    </div>
  </div>
</section>
