---
import Icon from './Icon.astro';
import { site } from '../config/site.ts';

// Ne s'affiche que si la config contient au moins un avis authentique (tableau vide par défaut).
const { avis } = site;
const etoiles = [1, 2, 3, 4, 5];
---

{
  avis.length > 0 && (
    <section class="border-t border-line bg-paper-deep" aria-labelledby="avis-titre">
      <div class="container-page py-16 sm:py-24">
        <p class="eyebrow">Avis clients</p>
        <h2 id="avis-titre" class="mt-3 text-3xl leading-tight font-bold sm:text-4xl">
          Ils m'ont fait confiance
        </h2>
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {avis.map(({ auteur, texte, commune, note, source }) => (
            <li class="rounded-xl border border-line bg-white p-6 sm:p-8">
              <figure class="flex h-full flex-col">
                {note && (
                  <p class="flex gap-1">
                    <span class="sr-only">Note : {note} sur 5</span>
                    {etoiles.map((rang) => (
                      <Icon name="etoile" class={rang <= note ? 'size-5 fill-current' : 'size-5'} />
                    ))}
                  </p>
                )}
                <blockquote class="mt-4 flex-1">
                  <p>«&nbsp;{texte}&nbsp;»</p>
                </blockquote>
                <figcaption class="mt-6 text-sm text-muted">
                  <span class="font-bold text-ink">{auteur}</span>
                  {commune && <span>, {commune}</span>}
                  {source && <span> · {source}</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
