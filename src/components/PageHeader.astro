---
import CircuitPattern from './CircuitPattern.astro';
import Icon from './Icon.astro';

interface Lien {
  href: string;
  label: string;
}

interface Props {
  titre: string;
  eyebrow?: string;
  intro?: string;
  /** Fil d'Ariane : pages parentes. La page courante est ajoutée à la fin. */
  fil?: Lien[];
  /** Libellé de la page courante dans le fil d'Ariane (par défaut, le titre). */
  filCourant?: string;
}

const { titre, eyebrow, intro, fil, filCourant = titre } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-line">
  <CircuitPattern variant="hero" class="absolute inset-0 -z-10 size-full text-ink" />
  <div class="container-page py-12 sm:py-20">
    {
      fil && (
        <nav aria-label="Fil d'Ariane" class="mb-8 text-sm">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-muted">
            {fil.map(({ href, label }) => (
              <li class="flex items-center gap-2">
                <a href={href} class="underline-offset-4 hover:text-ink hover:underline">
                  {label}
                </a>
                <Icon name="chevron" class="size-4" />
              </li>
            ))}
            <li aria-current="page" class="font-bold text-ink">
              {filCourant}
            </li>
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl">{titre}</h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
