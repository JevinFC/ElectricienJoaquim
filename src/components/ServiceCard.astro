---
import type { CollectionEntry } from 'astro:content';
import Etiquette from './Etiquette.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { repereService } from '../lib/collections.ts';

interface Props {
  service: CollectionEntry<'services'>;
  /** Niveau du titre, selon la hiérarchie de la page. */
  headingLevel?: 2 | 3;
}

const { service, headingLevel = 3 } = Astro.props;
const Titre = headingLevel === 2 ? 'h2' : 'h3';
const { titre, resume, etiquette, image, imageAlt } = service.data;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-conteneur border border-bordure bg-tuffeau-clair transition-colors hover:border-cuivre has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-cuivre"
>
  <div class="relative">
    <Photo
      src={image}
      alt={imageAlt}
      width={720}
      height={540}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-4/3 w-full"
    />
    <Etiquette repere={repereService(service)} texte={etiquette} class="absolute top-3 left-3" />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <Titre class="text-xl leading-snug font-bold">
      <a href={`/services/${service.id}/`} class="after:absolute after:inset-0 focus-visible:outline-none">
        {titre}
      </a>
    </Titre>
    <p class="mt-3 flex-1 text-gris-ardoise">{resume}</p>
    <span class="mt-6 inline-flex items-center gap-2 font-semibold text-cuivre" aria-hidden="true">
      En savoir plus
      <Icon name="fleche" class="size-5 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>
