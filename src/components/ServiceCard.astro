---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'services'>;
  /** Niveau du titre, selon la hiérarchie de la page. */
  headingLevel?: 2 | 3;
}

const { service, headingLevel = 3 } = Astro.props;
const Titre = headingLevel === 2 ? 'h2' : 'h3';
const { titre, description, icone } = service.data;
---

<article
  class="group relative flex h-full flex-col rounded-xl border border-line bg-white p-6 transition-colors hover:border-ink has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-ink sm:p-8"
>
  <span class="inline-flex size-14 items-center justify-center rounded-lg bg-paper-deep text-ink">
    <Icon name={icone} class="size-8" />
  </span>
  <Titre class="mt-6 text-xl leading-snug font-bold">
    <a href={`/services/${service.id}/`} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none">
      {titre}
    </a>
  </Titre>
  <p class="mt-3 flex-1 text-muted">{description}</p>
  <span class="mt-6 inline-flex items-center gap-2 font-bold" aria-hidden="true">
    En savoir plus
    <Icon name="fleche" class="size-5 transition-transform group-hover:translate-x-1" />
  </span>
</article>
