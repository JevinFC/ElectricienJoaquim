---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Etiquette from './Etiquette.astro';
import { formatDateIso, formatMoisAnnee } from '../lib/format.ts';

interface Props {
  realisation: CollectionEntry<'realisations'>;
  /** Service lié : son libellé est repris sur l'étiquette de la photo. */
  service: CollectionEntry<'services'>;
  /** Niveau du titre, selon la hiérarchie de la page. */
  headingLevel?: 2 | 3 | 4;
}

const { realisation, service, headingLevel = 3 } = Astro.props;
const Titre = headingLevel === 2 ? 'h2' : headingLevel === 4 ? 'h4' : 'h3';
const { titre, ville, date, couverture } = realisation.data;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-conteneur border border-bordure bg-tuffeau-clair transition-colors hover:border-cuivre has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-cuivre"
>
  <div class="relative">
    <Image
      src={couverture.src}
      alt={couverture.alt}
      width={800}
      height={600}
      sizes="(min-width: 640px) 50vw, 100vw"
      class="aspect-4/3 w-full object-cover"
    />
    <Etiquette texte={service.data.etiquette} surPhoto class="absolute top-3 left-3" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <Titre class="text-lg leading-snug font-bold">
      <a href={`/realisations/#realisation-${realisation.id}`} class="after:absolute after:inset-0 focus-visible:outline-none">
        {titre}
      </a>
    </Titre>
    <p class="mt-auto pt-3 text-sm text-gris-ardoise">
      {ville} · <time datetime={formatDateIso(date)}>{formatMoisAnnee(date)}</time>
    </p>
  </div>
</article>
