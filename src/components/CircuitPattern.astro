---
/**
 * Motif d'identité : fines lignes et points de connexion inspirés des schémas
 * électriques. Purement décoratif. La couleur des traits suit currentColor
 * (classe text-*), avec une opacité volontairement très faible.
 *
 * - hero : schéma unifilaire (une ligne d'alimentation et ses départs), à droite ;
 * - coin : quelques tracés dans deux coins opposés.
 */
interface Props {
  variant?: 'hero' | 'coin';
  class?: string;
}

const { variant = 'coin', class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1440 720"
  preserveAspectRatio={variant === 'hero' ? 'xMaxYMid slice' : 'xMidYMid slice'}
  fill="none"
  aria-hidden="true"
>
  {
    variant === 'hero' ? (
      <>
        <g stroke="currentColor" stroke-opacity="0.13" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1440 80H1060V660" />
          <path d="M1060 150h184" />
          <path d="M1060 230H920l-40 40H794" />
          <path d="M1060 310h270l40 40h24" />
          <path d="M1060 390H954" />
          <path d="M1060 470h144" />
          <path d="M1060 550H900l-40-40H744" />
          <path d="M1060 630h240" />
          <circle cx="1250" cy="150" r="6" />
          <circle cx="788" cy="270" r="6" />
          <circle cx="1400" cy="350" r="6" />
          <circle cx="948" cy="390" r="6" />
          <circle cx="1210" cy="470" r="6" />
          <circle cx="738" cy="510" r="6" />
          <circle cx="1306" cy="630" r="6" />
        </g>
        <g fill="currentColor" fill-opacity="0.2">
          <circle cx="1060" cy="150" r="3.5" />
          <circle cx="1060" cy="230" r="3.5" />
          <circle cx="1060" cy="310" r="3.5" />
          <circle cx="1060" cy="390" r="3.5" />
          <circle cx="1060" cy="470" r="3.5" />
          <circle cx="1060" cy="550" r="3.5" />
          <circle cx="1060" cy="630" r="3.5" />
        </g>
        <circle cx="1060" cy="80" r="7" class="fill-accent" />
      </>
    ) : (
      <>
        <g stroke="currentColor" stroke-opacity="0.12" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1440 70h-230l-50 50h-150" />
          <path d="M1440 150h-150l-40 40h-100" />
          <path d="M0 640h190l50-50h140" />
          <path d="M0 560h120l40-40h90" />
          <circle cx="1004" cy="120" r="6" />
          <circle cx="1144" cy="190" r="6" />
          <circle cx="386" cy="590" r="6" />
          <circle cx="256" cy="520" r="6" />
        </g>
        <circle cx="1160" cy="120" r="5" class="fill-accent" />
      </>
    )
  }
</svg>
