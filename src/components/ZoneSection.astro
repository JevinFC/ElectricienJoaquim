---
import { site } from '../config/site.ts';

const { zone } = site;
// Communes en texte courant, plus discret qu'une grille : « Tours, Joué-lès-Tours… et Langeais ».
const communes = new Intl.ListFormat('fr', { type: 'conjunction' }).format(zone.communes);
---

<section class="border-t border-bordure py-16 sm:py-24" aria-labelledby="zone-titre">
  <div class="container-page grid gap-8 lg:grid-cols-[2fr_3fr] lg:gap-16">
    <h2 id="zone-titre" class="text-3xl leading-tight font-bold sm:text-4xl">J'interviens {zone.libelle}</h2>
    <div>
      <p class="text-lg">
        Je me déplace chez les particuliers dans tout le département ({zone.departement}, {zone.numeroDepartement}).
      </p>
      <p class="mt-4 text-gris-ardoise">
        <span class="font-semibold text-ardoise">Principales communes desservies&nbsp;:</span>
        {communes}.
      </p>
      <p class="mt-4 text-gris-ardoise">Votre commune n'apparaît pas dans la liste&nbsp;? Contactez-moi.</p>
      <a href="/contact/" class="btn btn-secondary mt-8">Me contacter</a>
    </div>
  </div>
</section>
