---
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-700.css';
import '../styles/global.css';

import manrope400 from '@fontsource/manrope/files/manrope-latin-400-normal.woff2?url';
import manrope700 from '@fontsource/manrope/files/manrope-latin-700-normal.woff2?url';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import ogDefault from '../assets/og-default.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileCallButton from '../components/MobileCallButton.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { site } from '../config/site.ts';

interface Props {
  /** Titre de la page, complété automatiquement par le nom de l'entreprise. */
  title: string;
  /** Meta description, idéalement entre 120 et 160 caractères. */
  description: string;
  /** Image de partage (Open Graph). Un SVG est remplacé par l'image par défaut. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Exclut la page des moteurs de recherche (page 404…). */
  noindex?: boolean;
}

const { title, description, image, imageAlt, noindex = false } = Astro.props;

const titreComplet = `${title} | ${site.entreprise.nom}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

// Les réseaux sociaux n'acceptent pas le SVG : image par défaut dans ce cas.
const imagePartagee = image && image.format !== 'svg' ? image : undefined;
const og = await getImage({
  src: imagePartagee ?? ogDefault,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  layout: 'none',
});
const ogUrl = new URL(og.src, site.url).href;
const ogAlt = imagePartagee && imageAlt ? imageAlt : `${site.entreprise.nom}, électricien ${site.zone.libelle}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fafaf7" />
    <link rel="preload" href={manrope700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manrope400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.entreprise.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <SchemaOrg image={ogUrl} />
  </head>
  <body class="flex min-h-dvh flex-col pb-24 md:pb-0">
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallButton />
  </body>
</html>
